# copy to cloud/.env and adjust as needed
# docker compose -f cloud/docker-compose.yml --env-file cloud/.env up --build

POSTGRES_USER=pagent
POSTGRES_PASSWORD=pagent
POSTGRES_DB=pagent
POSTGRES_PORT=5432

MINIO_ROOT_USER=pagent
MINIO_ROOT_PASSWORD=pagentminio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
CLOUD_S3_BUCKET=pagent-artifacts

CLOUD_JWT_SECRET=cloud-dev-secret-change-me
CLOUD_DEMO_MODE=1
CLOUD_DEMO_USERNAME=admin
CLOUD_DEMO_PASSWORD=123
CLOUD_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:5174,http://localhost:5174
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=deepseek-v4-flash
CLOUD_LLM_BASE_URL=https://api.deepseek.com
CLOUD_RUNTIME_ROOT=/var/pagent/runtime

API_PORT=8787
WEB_PORT=8080
