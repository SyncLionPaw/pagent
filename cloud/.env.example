# 复制为 cloud/.env，供本地开发使用。
# docker compose -f cloud/docker-compose.yml --env-file cloud/.env up -d

# PostgreSQL
POSTGRES_USER=pagent
POSTGRES_PASSWORD=pagent
POSTGRES_DB=pagent
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=pagentredis
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=pagent
MINIO_ROOT_PASSWORD=pagentminio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# 模型服务：后端连大模型用，必填（否则对话无法运行）
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=deepseek-v4-flash
CLOUD_LLM_BASE_URL=https://api.deepseek.com
